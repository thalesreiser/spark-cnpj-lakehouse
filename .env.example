# Copie para .env e ajuste. Nunca versione o .env.
# Valores abaixo são APENAS para desenvolvimento local (containers na sua máquina).

# --- MinIO (armazenamento S3 local) ---
# A senha precisa ter pelo menos 8 caracteres.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=troque-me
LAKEHOUSE_BUCKET=lakehouse

# --- Recursos do Spark (padrão pensado para máquinas com ~8 GB de RAM) ---
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=1g

# --- Amostragem (RNF-03): fração dos dados processada ---
SPARK_SAMPLE_FRACTION=0.1
