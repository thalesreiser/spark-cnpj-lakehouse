# Copy to .env and adjust. Never commit .env.
# The values below are ONLY for local development (containers on your machine).

# --- MinIO (local S3 storage) ---
# The password must be at least 8 characters long.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
LAKEHOUSE_BUCKET=lakehouse

# --- Spark resources (defaults sized for machines with ~8 GB of RAM) ---
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=1g

# --- Sampling (RNF-03): fraction of the data to process ---
# Use 1.0 for `make bronze-check`: the row-count proof compares every source line.
SPARK_SAMPLE_FRACTION=0.1
